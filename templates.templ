package main

import "fmt"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Go Blog</title>
			<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		</head>
		<body class="bg-light">
			<nav class="navbar navbar-dark bg-dark mb-4">
				<div class="container" style="max-width: 720px;">
					<a class="navbar-brand" href="/">Go Blog</a>
				</div>
			</nav>
			<main class="container pb-5" style="max-width: 720px;">
				{ children... }
			</main>
		</body>
	</html>
}

templ IndexPage(posts []Post) {
	@Layout("Home") {
		<div class="card mb-4 shadow-sm">
			<div class="card-body">
				<h2 class="h5 card-title mb-3">New post</h2>
				<form
					hx-post="/posts"
					hx-target="#posts"
					hx-swap="afterbegin"
					hx-on--after-request="if (event.detail.successful) this.reset()"
				>
					<div class="mb-3">
						<input type="text" name="title" class="form-control" placeholder="Title" required maxlength="200"/>
					</div>
					<div class="mb-3">
						<textarea name="body" class="form-control" rows="4" placeholder="Write something..." required></textarea>
					</div>
					<button type="submit" class="btn btn-primary">Publish</button>
				</form>
			</div>
		</div>
		<div id="posts">
			for _, p := range posts {
				@PostCard(p)
			}
		</div>
	}
}

templ PostCard(p Post) {
	<article id={ fmt.Sprintf("post-%d", p.ID) } class="card mb-3 shadow-sm">
		<div class="card-body">
			<h2 class="h4 card-title">
				<a href={ templ.SafeURL(fmt.Sprintf("/posts/%d", p.ID)) } class="text-decoration-none">{ p.Title }</a>
			</h2>
			<p class="text-muted small mb-2">{ p.CreatedAt.Format("2 Jan 2006, 15:04") }</p>
			<p class="card-text">{ excerpt(p.Body, 200) }</p>
			<a href={ templ.SafeURL(fmt.Sprintf("/posts/%d", p.ID)) } class="btn btn-sm btn-outline-primary">Read more</a>
			<button
				class="btn btn-sm btn-outline-danger"
				hx-delete={ fmt.Sprintf("/posts/%d", p.ID) }
				hx-target={ fmt.Sprintf("#post-%d", p.ID) }
				hx-swap="outerHTML"
				hx-confirm="Delete this post?"
			>Delete</button>
		</div>
	</article>
}

templ PostPage(p Post) {
	@Layout(p.Title) {
		<a href="/" class="btn btn-link px-0 mb-2">&larr; All posts</a>
		<article class="card shadow-sm">
			<div class="card-body">
				<h1 class="h3 card-title">{ p.Title }</h1>
				<p class="text-muted small">{ p.CreatedAt.Format("2 January 2006, 15:04") }</p>
				<div class="mb-4" style="white-space: pre-wrap;">{ p.Body }</div>
				<button
					class="btn btn-sm btn-outline-danger"
					hx-delete={ fmt.Sprintf("/posts/%d?redirect=1", p.ID) }
					hx-confirm="Delete this post?"
				>Delete</button>
			</div>
		</article>
	}
}

func excerpt(s string, n int) string {
	r := []rune(s)
	if len(r) <= n {
		return s
	}
	return string(r[:n]) + "…"
}
